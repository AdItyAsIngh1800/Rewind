# Copy to .env and fill in. Never commit .env.
# Secrets and credentials never enter the database or this repository.

# --- Supabase (database, storage, auth) ---
# Project ref is the subdomain of your project URL: https://<ref>.supabase.co
SUPABASE_PROJECT_REF=
SUPABASE_REGION=ap-southeast-1
SUPABASE_DB_PASSWORD=

# Public API surface. The anon key is safe to expose to the browser; RLS is what
# protects the data. The service role key is NOT safe to expose and is never used
# from the frontend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket names (created by supabase/migrations/0001).
SUPABASE_BUCKET_MEDIA=case-media
SUPABASE_BUCKET_EVIDENCE=evidence-snapshots

# --- Escape hatch ---
# Full DSN override, bypassing the Supabase pooler. Used by CI, which runs
# integration tests against an ephemeral postgres container. Leave blank locally.
DATABASE_URL=

# --- Redis / job queue ---
REDIS_URL=redis://localhost:6379/0

# --- Pipeline versions (recorded on every processing run) ---
CONFIG_VERSION=v0.1.0
DATASET_VERSION=unset

# --- API ---
# Accounts, name:password:role, comma-separated. Roles: analyst (derived evidence only)
# and investigator (footage and changes too). See docs/10-security-and-privacy.md.
REWIND_USERS=investigator:change-me:investigator,analyst:change-me:analyst
# Signs the login session cookies. Optional with one API process; required, and the
# same value everywhere, when running more than one.
REWIND_SESSION_SECRET=
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
