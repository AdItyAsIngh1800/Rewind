# Copy to .env and fill in. Never commit .env.
# Secrets and credentials never enter the database or this repository.

# --- Database ---
POSTGRES_USER=rewind
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=rewind
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis / job queue ---
REDIS_URL=redis://localhost:6379/0

# --- Storage ---
# Local filesystem for MVP; S3-compatible object storage later.
ARTIFACT_STORE=./data

# --- Pipeline versions (recorded on every processing run) ---
CONFIG_VERSION=v0.1.0
DATASET_VERSION=unset

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
