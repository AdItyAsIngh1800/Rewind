# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Environment
.env
.env.local

# Data — the manifest is the committed record, not the media
data/samples/**
!data/samples/README.md
data/**/*.mp4
data/**/*.mkv
data/**/*.png
data/**/*.jpg
# The .blend is a build artifact, regenerated from ml/configs/scene_v1.json
# by `make scene`. The config is the committed record, not the binary.
*.blend
*.blend1

# Model weights are never committed — including checkpoints that tooling
# downloads into the working directory rather than into ml/models/.
*.pt
*.pth
*.onnx

# Build / runtime artifacts
artifacts/demo-assets/**
!artifacts/demo-assets/README.md
artifacts/render.log
node_modules/
dist/
.DS_Store

# Local tooling
mlruns/
.coverage
htmlcov/
