  "render": {
    "engine": "BLENDER_EEVEE",
    "fps": 10,
    "duration_s": 45.0,
    "_comment": "EEVEE rather than Cycles: path tracing buys realism the detector does not need and costs hours per case. Object index and depth passes are consumed in-process and never written to disk.",
    "_engine_note": "Blender 4.2 called this BLENDER_EEVEE_NEXT; 5.x reverted to BLENDER_EEVEE. build_scene.py falls back rather than failing on the rename."
  },
  "lighting": {
    "type": "overhead_area",
    "colour_temperature_k": 4000,
    "_comment": "Constant across all six cases so a detection failure is attributable to the scene rather than to the light. No skylights, no daylight, whatever the visual reference shows."
  }
