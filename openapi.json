{
  "components": {
    "schemas": {
      "CreateCaseRequest": {
        "description": "Body of a request to create a case and queue its processing run.",
        "properties": {
          "case_ref": {
            "description": "Which rendered case or media set to process",
            "title": "Case Ref",
            "type": "string"
          },
          "config_version": {
            "default": "v0.1.0",
            "title": "Config Version",
            "type": "string"
          },
          "dataset_version": {
            "title": "Dataset Version",
            "type": "string"
          }
        },
        "required": [
          "dataset_version",
          "case_ref"
        ],
        "title": "CreateCaseRequest",
        "type": "object"
      },
      "CreateCaseResponse": {
        "description": "Acknowledgement of an accepted case, before any processing has happened.",
        "properties": {
          "incident_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Incident Id"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "status"
        ],
        "title": "CreateCaseResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "description": "Liveness response, including the contract version this API is serving.",
        "properties": {
          "api_version": {
            "default": "0.1.0",
            "title": "Api Version",
            "type": "string"
          },
          "checked_at": {
            "format": "date-time",
            "title": "Checked At",
            "type": "string"
          },
          "schema_version": {
            "default": "1.0.0",
            "title": "Schema Version",
            "type": "string"
          },
          "status": {
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "checked_at"
        ],
        "title": "Health",
        "type": "object"
      },
      "Metrics": {
        "description": "The metric set from specification \u00a7N.\n\nZeroed until the pipeline runs. The shape is fixed now so the System Health\nscreen can be built against it.",
        "properties": {
          "api_error_rate": {
            "default": 0.0,
            "title": "Api Error Rate",
            "type": "number"
          },
          "dead_letter_jobs": {
            "default": 0,
            "title": "Dead Letter Jobs",
            "type": "integer"
          },
          "event_generation_rate": {
            "default": 0.0,
            "title": "Event Generation Rate",
            "type": "number"
          },
          "evidence_coverage": {
            "default": 1.0,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Evidence Coverage",
            "type": "number"
          },
          "frames_per_second": {
            "default": 0.0,
            "title": "Frames Per Second",
            "type": "number"
          },
          "incident_detection_rate": {
            "default": 0.0,
            "title": "Incident Detection Rate",
            "type": "number"
          },
          "queue_depth": {
            "default": 0,
            "title": "Queue Depth",
            "type": "integer"
          },
          "queue_oldest_age_s": {
            "default": 0.0,
            "title": "Queue Oldest Age S",
            "type": "number"
          },
          "report_generation_latency_s": {
            "default": 0.0,
            "title": "Report Generation Latency S",
            "type": "number"
          },
          "tracking_id_switch_rate": {
            "default": 0.0,
            "title": "Tracking Id Switch Rate",
            "type": "number"
          },
          "unsupported_claim_rate": {
            "default": 0.0,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Unsupported Claim Rate",
            "type": "number"
          },
          "worker_retries": {
            "default": 0,
            "title": "Worker Retries",
            "type": "integer"
          }
        },
        "title": "Metrics",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Endpoints marked **not yet implemented** return 501 with the correct response shape already defined. The frontend is built against this contract from Week 4; the pipeline fills it in behind.",
    "summary": "Evidence-backed AI incident reconstruction engine for multi-camera video",
    "title": "REWIND",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/cases": {
      "get": {
        "description": "List incidents for the case inbox, filtered by severity and status.\n\nNot present in specification \u00a7F, which jumps straight to fetching one case by\nid. The Case Inbox screen in \u00a7G filters incidents by severity, time, location\nand status, and cannot be built without a collection endpoint \u2014 so \u00a7F is\nincomplete rather than this being new scope.\n\nNot yet implemented \u2014 delivered by E6.2.",
        "operationId": "list_cases_api_v1_cases_get",
        "parameters": [
          {
            "in": "query",
            "name": "severity",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Severity"
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response List Cases Api V1 Cases Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Cases",
        "tags": [
          "cases"
        ]
      },
      "post": {
        "description": "Create a processing run and queue the pipeline.\n\nNot yet implemented \u2014 delivered by E2.2.",
        "operationId": "create_case_api_v1_cases_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCaseRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateCaseResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Case",
        "tags": [
          "cases"
        ]
      }
    },
