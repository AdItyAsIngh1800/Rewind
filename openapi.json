    "/api/v1/cases/{case_id}/timeline": {
      "get": {
        "description": "Return the cross-camera semantic event timeline of a case's run.\n\nA case id with no explicit window returns its incident's rewind window, which is\nwhat opening a case means. An explicit window always wins, so the investigator can\nwiden it; a run id has no window of its own and returns everything.",
        "operationId": "get_timeline_api_v1_cases__case_id__timeline_get",
        "parameters": [
          {
            "description": "Case (incident) identifier",
            "in": "path",
            "name": "case_id",
            "required": true,
            "schema": {
              "description": "Case (incident) identifier",
              "title": "Case Id",
              "type": "string"
            }
          },
          {
            "description": "Window start, seconds",
            "in": "query",
            "name": "start_s",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Window start, seconds",
              "title": "Start S"
            }
          },
          {
            "description": "Window end, seconds",
            "in": "query",
            "name": "end_s",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Window end, seconds",
              "title": "End S"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Timeline"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Timeline",
        "tags": [
          "cases"
        ]
      }
    },
